{
  "title": "我的日程",
  "config": {
    "step": {
      "user": {
        "title": "添加我的日程",
        "description": "装好后侧边栏会出现「我的工作日」和「维护台账」两个页面。"
      }
    },
    "abort": {
      "single_instance_allowed": "只能添加一个我的日程实例。"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "选项",
        "data": {
          "sync_due_to_todos": "自动把维护到期项写成待办",
          "soon_days": "提前几天算快到期",
          "holiday_url": "放假数据地址模板",
          "notify_service": "通知服务"
        },
        "data_description": {
          "holiday_url": "保留 {year} 占位符",
          "notify_service": "例如 notify.mobile_app_iphone，留空不发"
        }
      }
    }
  },
  "services": {
    "get_snapshot": {
      "name": "读取全部数据",
      "description": "一次返回工作日、待办、维护项目的完整快照，供两个网页使用。",
      "fields": {}
    },
    "set_day": {
      "name": "改某一天",
      "description": "把某一天设为上班、休息，或恢复按国家安排。",
      "fields": {
        "date": {
          "name": "date",
          "description": "日期，如 2026-11-28"
        },
        "mode": {
          "name": "mode",
          "description": "work / rest / auto"
        }
      }
    },
    "set_custom": {
      "name": "批量设置工作日",
      "description": "一次替换自定义上班日与休息日清单。",
      "fields": {
        "work": {
          "name": "work",
          "description": "逗号分隔的上班日"
        },
        "rest": {
          "name": "rest",
          "description": "逗号分隔的休息日"
        }
      }
    },
    "clear_custom": {
      "name": "清空自定义",
      "description": "清空全部自定义上班日与休息日。",
      "fields": {}
    },
    "refresh_data": {
      "name": "刷新放假数据",
      "description": "清掉缓存并重新拉取当年与次年放假安排。",
      "fields": {}
    },
    "set_year_data": {
      "name": "手工覆盖整年",
      "description": "用文本覆盖某一年的放假与补班安排，留空恢复自动获取。",
      "fields": {
        "year": {
          "name": "year",
          "description": "年份"
        },
        "data": {
          "name": "data",
          "description": "年度安排文本"
        }
      }
    },
    "set_todos": {
      "name": "设置待办",
      "description": "整批替换待办清单，每行「[x] 日期 内容」。",
      "fields": {
        "data": {
          "name": "data",
          "description": "待办文本"
        }
      }
    },
    "set_anniversaries": {
      "name": "设置纪念日",
      "description": "整批替换纪念日，每行「名称: 日期」。",
      "fields": {
        "data": {
          "name": "data",
          "description": "纪念日文本"
        }
      }
    },
    "add_project": {
      "name": "新建维护项目",
      "description": "创建一个维护项目，中文名需要同时提供英文标识。",
      "fields": {
        "name": {
          "name": "name",
          "description": "项目名称"
        },
        "slug": {
          "name": "slug",
          "description": "英文标识"
        },
        "type": {
          "name": "type",
          "description": "预置类型"
        },
        "need_counter": {
          "name": "need_counter",
          "description": "是否计数"
        },
        "counter_unit": {
          "name": "counter_unit",
          "description": "计数单位"
        },
        "counter_label": {
          "name": "counter_label",
          "description": "计数显示名"
        },
        "counter": {
          "name": "counter",
          "description": "当前计数"
        }
      }
    },
    "update_project": {
      "name": "修改维护项目",
      "description": "改名称、计数开关、单位与显示名。",
      "fields": {
        "slug": {
          "name": "slug",
          "description": "英文标识"
        },
        "name": {
          "name": "name",
          "description": "项目名称"
        },
        "need_counter": {
          "name": "need_counter",
          "description": "是否计数"
        },
        "counter_unit": {
          "name": "counter_unit",
          "description": "计数单位"
        },
        "counter_label": {
          "name": "counter_label",
          "description": "计数显示名"
        }
